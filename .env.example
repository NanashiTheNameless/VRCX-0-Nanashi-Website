# Public origins. The API host must be the backend hostname, not the website host.
REMOTESYNC_API_HOST=vrcx-api.example.com
REMOTESYNC_WEB_ORIGINS=https://vrcx.example.com

# Account policy
REMOTESYNC_REGISTRATION=closed
REMOTESYNC_DEFAULT_QUOTA=1GiB
REMOTESYNC_COLLECTOR_DEFAULT_ALLOWED=false
REMOTESYNC_COLLECTOR_MAX_SESSIONS=64
REMOTESYNC_POLICY_URL=

# Group ID that owns files in ./secrets; grant those files mode 0640.
REMOTESYNC_SECRETS_GID=1000

# Mail
REMOTESYNC_MAIL_FROM=RemoteSync <remotesync@example.com>

# GHCR compose defaults to S3-compatible storage. For Cloudflare R2:
REMOTESYNC_BLOB_BACKEND=s3
REMOTESYNC_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
REMOTESYNC_S3_BUCKET=remotesync
REMOTESYNC_S3_REGION=auto
REMOTESYNC_S3_PATH_STYLE=true
REMOTESYNC_INSTANCE_STATEMENT=
REMOTESYNC_INSTANCE_SIGNATURE=
