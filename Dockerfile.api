FROM rust:1.99-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p vrcx-0-nanashi-website-server
RUN mkdir -p /runtime-data && chown 10001:65532 /runtime-data

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/remotesync /usr/local/bin/remotesync
COPY --from=build --chown=10001:65532 /runtime-data /data
USER 10001:65532
ENTRYPOINT ["/usr/local/bin/remotesync"]
